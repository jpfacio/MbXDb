Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%files
    environment.yml /opt/mbxdb/environment.yml

%post
    set -eu
    micromamba create -y -j 2 -n mbxdb-env -f /opt/mbxdb/environment.yml
    micromamba clean -a -y

    # conda-forge megahit 1.2.9 is built for AVX2 and dies (SIGILL) on older
    # CPUs; swap in the upstream static generic x86-64 build and verify it.
    /opt/conda/envs/mbxdb-env/bin/python - <<'EOF'
import urllib.request
url = 'https://github.com/voutcn/megahit/releases/download/v1.2.9/MEGAHIT-1.2.9-Linux-x86_64-static.tar.gz'
urllib.request.urlretrieve(url, '/root/megahit-static.tar.gz')
EOF
    tar xzf /root/megahit-static.tar.gz -C /root
    cp /root/MEGAHIT-*-static/bin/* /opt/conda/envs/mbxdb-env/bin/
    mkdir -p /opt/conda/envs/mbxdb-env/share
    cp -r /root/MEGAHIT-*-static/share/megahit /opt/conda/envs/mbxdb-env/share/
    for c in megahit_core megahit_core_popcnt megahit_core_no_hw_accel; do
        /opt/conda/envs/mbxdb-env/bin/$c dumpversion
    done
    rm -rf /root/MEGAHIT-*-static /root/megahit-static.tar.gz

%environment
    export MAMBA_DEFAULT_ENV=mbxdb-env
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/envs/mbxdb-env/bin:/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8
